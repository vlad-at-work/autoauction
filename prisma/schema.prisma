generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Platform {
  MAX
  TELEGRAM
}

model Buyer {
  id               String   @id @default(cuid())
  platform         Platform
  platformUserId   String
  platformChatId   String?  // Chat ID for sending bot notifications
  platformUserName String?

  // Inquiry limits: 2 per month, resets every 15 days
  inquiriesUsedThisMonth Int      @default(0)
  inquiryLimitResetAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  inquiries Inquiry[]

  @@unique([platform, platformUserId])
  @@index([deletedAt])
}

model Inquiry {
  id      String @id @default(cuid())
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId String

  name  String
  email String?
  phone String

  model        String
  submodel     String
  transmission String
  color        String
  comment      String?
  consentAt    DateTime? // When buyer consented to data sharing

  createdAt DateTime @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  offers       Offer[]
  transactions Transaction[]

  @@index([expiresAt])
  @@index([buyerId])
  @@index([deletedAt])
}

model Dealer {
  id       String @id @default(cuid())
  username String @unique
  name     String?
  subName  String?
  phone    String?
  email    String?
  description String?
  active   Boolean @default(true)

  // Platform for dealer mini-app access (set on first login)
  platform         Platform?
  platformUserId   String?
  platformChatId   String?  // Chat ID for sending bot notifications

  // Authentication (bcrypt hash, set by dealer on first login)
  passwordHash     String?

  // Invite token system for dealer claiming
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  offers            Offer[]
  transactions      Transaction[]
  passwordResetCodes PasswordResetCode[]

  @@unique([platform, platformUserId])
  @@index([deletedAt])
  @@index([active])
  @@index([inviteToken])
}

// Time-limited password reset codes for dealers
model PasswordResetCode {
  id        String   @id @default(cuid())
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  dealerId  String

  code      String   // 6-digit code
  expiresAt DateTime // Code expires after 10 minutes
  usedAt    DateTime? // Null until used

  createdAt DateTime @default(now())

  @@index([dealerId])
  @@index([expiresAt])
}

model Offer {
  id        String  @id @default(cuid())
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String

  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  dealerId String

  price               Int
  configuration       String? // Комплектация
  deliveryTime        String? // Сроки поставки
  additionalComments  String? // Дополнительные комментарии
  confirmedMatch      Boolean // Подтверждение совпадения с требованиями
  confirmedAt         DateTime? // When dealer confirmed match

  createdAt DateTime @default(now())
  deletedAt DateTime?

  transaction Transaction?

  // Removed @@unique([inquiryId, dealerId]) to allow multiple offers per dealer
  // Cap of 5 offers per dealer per inquiry enforced in API
  @@index([inquiryId])
  @@index([dealerId])
  @@index([inquiryId, dealerId])
  @@index([deletedAt])
}

// Transaction: created when a user accepts an offer
// Replaces the old Lead model with better constraints
model Transaction {
  id        String  @id @default(cuid())
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String @unique // One transaction per offer

  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  dealerId String

  // Buyer info revealed to dealer upon acceptance
  buyerName  String
  buyerEmail String?
  buyerPhone String

  // Immutable snapshots for billing/invoices (not all fields may exist for legacy rows)
  offerPrice          Int?
  inquiryModel        String?
  inquirySubmodel     String?
  inquiryTransmission String?
  inquiryColor        String?
  dealerUsername      String?
  dealerName          String?
  dealerSubName       String?
  dealerPhone         String?
  dealerEmail         String?
  dealerDescription   String?

  // Manual bookkeeping (optional)
  amount     Int?
  invoicedAt DateTime?
  billedAt   DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?

  acceptedAt DateTime @default(now())
  closedAt   DateTime? // For future dealer confirmation
  deletedAt  DateTime?

  // Max 1 transaction per dealer per inquiry
  // Max 3 transactions per inquiry enforced in API
  @@unique([inquiryId, dealerId])
  @@index([inquiryId])
  @@index([dealerId])
  @@index([deletedAt])
  @@index([voidedAt])
  @@index([billedAt])
  @@index([paidAt])
}
